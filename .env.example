# Copy to .env.local for local development. Local values come from `supabase status`
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY). Never commit .env.local.

# Public: safe in the browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional locally; required in production (Cloudflare Turnstile site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret: used ONLY by scripts/sync-content.ts. Never set it in Vercel or expose it to the browser.
# For the hosted project, put URL + publishable + secret key in .env.production.local (see docs/DEPLOY.md).
SUPABASE_SECRET_KEY=
