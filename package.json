{
  "name": "ccdf-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "node scripts/validate-content.ts",
    "content:sync": "node scripts/sync-content.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset && npm run content:sync",
    "db:test": "supabase test db",
    "check:leaks": "node scripts/check-leaks.ts",
    "content:sync:prod": "node --env-file=.env.production.local scripts/sync-content.ts",
    "db:push": "supabase db push",
    "deploy:db": "supabase db push && npm run content:sync:prod"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
